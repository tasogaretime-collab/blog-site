---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = '感染症専門医が最新のエビデンスに基づいて医療・健康情報をわかりやすく解説します。', ogImage, ogType = 'website', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL('/images/og-default.png', Astro.site).href;
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).href : defaultOgImage;

// Footer: top 4 categories (tags with 2+ articles, by count desc)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tagCount = allPosts.flatMap(p => p.data.tags).reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {});
const topTags = Object.entries(tagCount)
  .filter(([, count]) => count >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow, max-image-preview:large" : "max-image-preview:large"} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Tasunaro ─ 感染症専門医の医療情報ブログ" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@Tasunaro" />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data (JSON-LD): WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Tasunaro ─ 感染症専門医の医療情報ブログ",
      "alternateName": "Tasunaro",
      "url": Astro.site?.href,
      "inLanguage": "ja",
      "description": "感染症専門医が最新のエビデンスに基づいて医療・健康情報をわかりやすく解説します。",
      "publisher": {
        "@type": "Organization",
        "name": "Tasunaro Health Information",
        "url": Astro.site?.href,
        "logo": {
          "@type": "ImageObject",
          "url": new URL("/images/profile.jpg", Astro.site).href
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "contact@tasunaro.com",
          "availableLanguage": ["Japanese", "ja"]
        },
        "sameAs": ["https://x.com/xRLtqMcxxZ75089"]
      },
      "author": {
        "@type": "Person",
        "name": "Tasunaro",
        "jobTitle": "感染症専門医",
        "url": new URL("/about/", Astro.site).href,
        "image": new URL("/images/profile.jpg", Astro.site).href,
        "sameAs": ["https://x.com/xRLtqMcxxZ75089"],
        "knowsAbout": ["感染症", "ワクチン", "抗菌薬", "渡航医学", "薬剤耐性"]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": new URL("/blog/?q={search_term_string}", Astro.site).href
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7787421522863807" crossorigin="anonymous"></script>

    <slot name="head" />

    <!-- Google Analytics (GA4) — production only -->
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-NDBGCC9WCV"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-NDBGCC9WCV');
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <img src="/images/profile.jpg" alt="Tasunaro" class="w-8 h-8 rounded-full object-cover" />
          <div>
            <div class="font-bold text-gray-900 group-hover:text-karada-blue transition-colors text-sm leading-tight">Tasunaro</div>
            <div class="hidden sm:block text-xs text-gray-500">感染症専門医の医療情報ブログ</div>
          </div>
        </a>
        <nav class="flex items-center gap-1">
          <a href="/blog/" class="px-3 py-1.5 text-sm text-gray-700 hover:text-karada-blue hover:bg-karada-blue-light rounded-lg transition-colors">記事</a>
          {topTags.length > 0 && (
            <details class="relative group" data-nav-categories>
              <summary class="list-none px-3 py-1.5 text-sm text-gray-700 hover:text-karada-blue hover:bg-karada-blue-light rounded-lg transition-colors cursor-pointer flex items-center gap-1 select-none">
                カテゴリ
                <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="absolute right-0 mt-1 min-w-[200px] bg-white border border-gray-100 rounded-lg shadow-lg py-2 z-10">
                {topTags.map(([tag, count]) => (
                  <a href={`/blog/tag/${tag}/`} class="block px-4 py-2 text-sm text-gray-700 hover:text-karada-blue hover:bg-karada-blue-light transition-colors">
                    #{tag} <span class="text-xs text-gray-400">({count})</span>
                  </a>
                ))}
                <div class="border-t border-gray-100 mt-1 pt-1">
                  <a href="/blog/" class="block px-4 py-2 text-sm text-karada-blue font-medium hover:bg-karada-blue-light transition-colors">すべての記事を見る →</a>
                </div>
              </div>
            </details>
          )}
          <a href="/about/" class="px-3 py-1.5 text-sm text-gray-700 hover:text-karada-blue hover:bg-karada-blue-light rounded-lg transition-colors">プロフィール</a>
          <a href="/contact/" class="px-3 py-1.5 text-sm text-gray-700 hover:text-karada-blue hover:bg-karada-blue-light rounded-lg transition-colors">お問い合わせ</a>
        </nav>
        <script is:inline>
          // Close <details> dropdown when clicking outside
          document.addEventListener('click', (e) => {
            const detailsList = document.querySelectorAll('details[data-nav-categories]');
            detailsList.forEach((d) => {
              if (!d.contains(e.target)) d.removeAttribute('open');
            });
          });
        </script>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-300 mt-16">
      <div class="max-w-5xl mx-auto px-4 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-14">
          <div class="flex items-start gap-4">
            <img src="/images/profile.jpg" alt="Tasunaro" class="w-14 h-14 rounded-full object-cover flex-shrink-0" />
            <div>
              <div class="text-white font-bold mb-1">Tasunaro</div>
              <div class="text-sm text-gray-400 mb-3">感染症専門医</div>
              <a href="https://x.com/xRLtqMcxxZ75089" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                @Tasunaro
              </a>
            </div>
          </div>
          {topTags.length > 0 && (
            <div>
              <div class="text-white font-bold mb-4">カテゴリ</div>
              <ul class="space-y-2 text-sm">
                {topTags.map(([tag, count]) => (
                  <li><a href={`/blog/tag/${tag}/`} class="text-gray-400 hover:text-karada-blue transition-colors">#{tag} <span class="opacity-60">({count})</span></a></li>
                ))}
              </ul>
            </div>
          )}
          <div>
            <div class="text-white font-bold mb-4">コンテンツ</div>
            <ul class="space-y-2 text-sm">
              <li><a href="/blog/" class="text-gray-400 hover:text-karada-blue transition-colors">医療記事</a></li>
              <li><a href="/about/" class="text-gray-400 hover:text-karada-blue transition-colors">プロフィール</a></li>
              <li><a href="/contact/" class="text-gray-400 hover:text-karada-blue transition-colors">お問い合わせ</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-700 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-500">
          <p>© {new Date().getFullYear()} Tasunaro. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/privacy/" class="hover:text-gray-300">プライバシーポリシー</a>
            <a href="/disclaimer/" class="hover:text-gray-300">免責事項</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
